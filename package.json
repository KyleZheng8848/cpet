{
  "name": "cursor-pet",
  "version": "0.4.53",
  "description": "CPET：桌面宠物，对接 Cursor / OpenClaw / Claude Code / Codex / OpenCode。",
  "main": "./out/main/index.js",
  "author": "SofunAI Studio",
  "license": "MIT",
  "cpet": {
    "keepReleases": 20,
    "bundledSkins": [
      "赛博幽灵",
      "数字佳人"
    ],
    "repoUrl": "https://github.com/KyleZheng8848/cpet"
  },
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build:dictation": "node scripts/build-dictation.mjs",
    "postinstall": "node scripts/gen-icons.mjs",
    "dev": "node scripts/with-electron-env.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/with-electron-env.mjs preview",
    "start": "node scripts/with-electron-env.mjs preview",
    "smoke:skins": "node scripts/smoke-skins-window.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=29",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "node scripts/check-version-sync.mjs",
    "manifest": "node scripts/gen-update-manifest.mjs",
    "docs:downloads": "node scripts/gen-readme-downloads.mjs",
    "release:prune": "node scripts/prune-releases.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:version",
    "smoke:agents": "node scripts/smoke-agents.mjs",
    "smoke:agents:quick": "node scripts/smoke-agents.mjs --quick",
    "verify:release": "node scripts/verify-release-clean.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "verify:surface": "node scripts/verify-release-surface.mjs",
    "update:check": "node scripts/verify-release-surface.mjs",
    "prepackage": "npm run check:version",
    "package": "npm run icons && npm run build:dictation && electron-vite build && electron-builder && npm run verify:release && npm run release:prune",
    "package:mac": "npm run check:version && npm run icons && npm run build:dictation && electron-vite build && electron-builder --mac --arm64 && npm run verify:release && npm run release:prune",
    "package:mac:all": "npm run check:version && npm run icons && npm run build:dictation && electron-vite build && electron-builder --mac --arm64 --x64 && npm run verify:release && npm run release:prune",
    "package:win": "npm run check:version && npm run icons && electron-vite build && electron-builder --win && npm run verify:release && npm run release:prune",
    "package:linux": "npm run check:version && npm run icons && electron-vite build && electron-builder --linux && npm run verify:release && npm run release:prune",
    "release:publish": "node scripts/publish-release.mjs",
    "skins:publish": "node scripts/publish-skins.mjs",
    "ci": "npm run verify",
    "smoke:app": "node scripts/smoke-app.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "marked": "^14.1.4",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "docx-preview": "^0.3.6",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "koffi": "^3.1.2",
    "marked-katex-extension": "^5.1.10",
    "msedge-tts": "^2.0.7",
    "xlsx": "^0.18.5"
  },
  "contributors": [
    "KyleZheng8848"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KyleZheng8848/cpet.git"
  },
  "homepage": "https://github.com/KyleZheng8848/cpet#readme",
  "bugs": {
    "url": "https://github.com/KyleZheng8848/cpet/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
