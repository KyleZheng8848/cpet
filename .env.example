# Optional maintainer publishing only. Source builds and unit tests need no OSS credentials.
# Copy to .env.local; use your own bucket, public URLs and credentials.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
CPET_OSS_TARGET=oss://your-bucket/CPET/
CPET_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
CPET_DOWNLOAD_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/CPET/
